{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": { "correctness": "off" },
  "rules": {
    "no-restricted-globals": [
      "error",
      {
        "name": "require",
        "message": "Use checked imports so blocking APIs cannot bypass the server-thread rules.",
      },
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "bun:sqlite",
            "allowTypeImports": true,
            "message": "SQLite runs in a .worker.ts module.",
          },
          {
            "name": "node:sqlite",
            "allowTypeImports": true,
            "message": "SQLite runs in a .worker.ts module.",
          },
          {
            "name": "better-sqlite3",
            "allowTypeImports": true,
            "message": "SQLite runs in a .worker.ts module.",
          },
          {
            "name": "process",
            "importNames": [
              "default",
              "cpuUsage",
              "threadCpuUsage",
              "memoryUsage",
            ],
            "message": "Native process counters block the server thread.",
          },
          {
            "name": "node:process",
            "importNames": [
              "default",
              "cpuUsage",
              "threadCpuUsage",
              "memoryUsage",
            ],
            "message": "Native process counters block the server thread.",
          },
        ],
        "patterns": [
          {
            "regex": "^(node:)?(fs|child_process)$|^bun$",
            "importNamePattern": "Sync$",
            "allowTypeImports": true,
            "message": "Use asynchronous APIs. Legacy calls use a default fs import and a per-call known suppression.",
          },
          {
            "regex": "\\.(worker|cli)(\\.[cm]?[jt]sx?)?$|(^|/)(local|launch_cli)(\\.ts)?$",
            "allowTypeImports": true,
            "message": "Off-thread modules may only be imported as types; launch Workers or child processes instead.",
          },
        ],
      },
    ],
    "no-restricted-properties": [
      "error",
      { "property": "accessSync" },
      { "property": "appendFileSync" },
      { "property": "chmodSync" },
      { "property": "chownSync" },
      { "property": "closeSync" },
      { "property": "copyFileSync" },
      { "property": "cpSync" },
      { "property": "existsSync" },
      { "property": "fchmodSync" },
      { "property": "fchownSync" },
      { "property": "fdatasyncSync" },
      { "property": "fstatSync" },
      { "property": "fsyncSync" },
      { "property": "ftruncateSync" },
      { "property": "futimesSync" },
      { "property": "globSync" },
      { "property": "lchmodSync" },
      { "property": "lchownSync" },
      { "property": "linkSync" },
      { "property": "lstatSync" },
      { "property": "lutimesSync" },
      { "property": "mkdirSync" },
      { "property": "mkdtempSync" },
      { "property": "mkdtempDisposableSync" },
      { "property": "openSync" },
      { "property": "opendirSync" },
      { "property": "readFileSync" },
      { "property": "readSync" },
      { "property": "readdirSync" },
      { "property": "readlinkSync" },
      { "property": "readvSync" },
      { "property": "realpathSync" },
      { "property": "renameSync" },
      { "property": "rmSync" },
      { "property": "rmdirSync" },
      { "property": "statSync" },
      { "property": "statfsSync" },
      { "property": "symlinkSync" },
      { "property": "truncateSync" },
      { "property": "unlinkSync" },
      { "property": "utimesSync" },
      { "property": "writeFileSync" },
      { "property": "writeSync" },
      { "property": "writevSync" },
      { "property": "spawnSync" },
      { "property": "execSync" },
      { "property": "execFileSync" },
      { "object": "process", "property": "cpuUsage" },
      { "object": "process", "property": "threadCpuUsage" },
      { "object": "process", "property": "memoryUsage" },
    ],
  },
  "overrides": [
    {
      // Public launcher entrypoints keep their installed/user-facing names.
      "files": [
        "src/local.ts",
        "src/launch_cli.ts",
        "**/*.worker.{ts,mjs}",
        "**/*.cli.ts",
      ],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-imports": "off",
        "no-restricted-properties": "off",
      },
    },
  ],
}
