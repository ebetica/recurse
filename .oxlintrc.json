{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "overrides": [
    {
      "files": ["src/extensions/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "process",
            "property": "env",
            "message": "Extensions must use the conversation tool environment or creation options, not the server environment."
          }
        ],
        "no-restricted-imports": [
          "warn",
          {
            "patterns": [
              {
                "regex": "(^src(/|$)|^\\.{1,2}/(?:.*/)?src(/|$)|^(?:\\.\\./){3}[^.])",
                "message": "Extensions must not import Recurse src; receive host values or use extension-local helpers."
              }
            ]
          }
        ]
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
